{
  "name": "morrow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local .neander/migrate.mjs",
    "test:phase1": "node --env-file=.env.local scripts/check-phase1.mjs http://localhost:3000",
    "test:phase2": "node --env-file=.env.local scripts/check-phase2.mjs http://localhost:3000",
    "test:phase3": "node --env-file=.env.local scripts/check-phase3.mjs http://localhost:3000",
    "db:seed": "node --experimental-strip-types scripts/seed-template.ts",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm run check && pnpm run test && pnpm run test:policy && pnpm run build",
    "test:template": "node scripts/verify-template.mjs",
    "test:production": "node scripts/verify-template.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.27",
    "@fontsource/inter": "5.3.0",
    "@next/env": "16.4.6",
    "better-auth": "1.7.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.23.0",
    "next": "16.4.6",
    "pg": "8.23.0",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.27",
    "drizzle-kit": "0.31.10",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "playwright": "1.65.1"
  },
  "license": "MIT"
}
